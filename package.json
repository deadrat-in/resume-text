{
  "name": "resume-text",
  "version": "0.1.0",
  "description": "JSON Resume to ATS-friendly plain text. Deterministic, label:value output that survives ATS auto-population (Workday, etc).",
  "keywords": [
    "resume",
    "cv",
    "jsonresume",
    "ats",
    "plain",
    "text",
    "workday",
    "json",
    "export"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "resume-text": "./bin/resume-text.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "vite build --watch"
  },
  "dependencies": {
    "sade": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.0"
  }
}